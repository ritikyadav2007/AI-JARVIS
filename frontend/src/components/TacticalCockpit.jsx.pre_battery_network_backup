                      <span className="font-label-code-xs text-label-code-xs text-on-surface-variant">
                        ALT {drone.alt} // BATT {drone.batt}%
                      </span>
                    </div>
                  </div>
                  <span className="px-1.5 py-0.5 rounded text-[10px] font-label-code-xs uppercase tracking-wider bg-primary-container/20 text-primary-container">
                    {drone.status}
                  </span>
                </div>
              ))}
