                className="py-space-xs px-2 rounded bg-error-container/40 hover:bg-error-container/80 text-on-error-container font-label-code-xs text-label-code-xs transition-all flex items-center justify-center gap-1 cursor-pointer"
              >
                <span className="material-symbols-outlined text-[14px]">warning</span>
                <span>SAFE ABORT</span>
              </button>
            </div>
          </div>

          {/* Optical Tactical Feed: Sat-Relay Malibu Airspace */}
          <div className="bg-surface-container-low/80 backdrop-blur-2xl p-space-sm rounded-xl shadow-xl flex flex-col gap-space-xs border border-secondary/20">
            <div className="flex items-center justify-between">
              <span className="font-label-code-xs text-label-code-xs text-on-surface-variant uppercase tracking-wider">
                OPTICAL TACTICAL FEED
              </span>
              <span className="font-label-code-xs text-label-code-xs text-primary-container animate-pulse flex items-center gap-1">
                <span className="w-1.5 h-1.5 rounded-full bg-primary-container"></span>
                LIVE RECON
