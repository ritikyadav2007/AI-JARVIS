            onClick={handleVeronica}
            className="group relative px-space-md py-space-sm rounded-lg bg-surface-container/80 hover:bg-secondary-container transition-all flex flex-col items-center justify-center gap-1 border border-secondary/30 cursor-pointer"
          >
            <div className="flex items-center gap-1 text-secondary group-hover:text-on-secondary-container">
              <span className="material-symbols-outlined text-[18px]">flight_takeoff</span>
              <span className="font-label-code-xs text-label-code-xs uppercase font-bold tracking-wider">
                VERONICA
              </span>
            </div>
            <span className="font-label-telemetry text-[11px] text-on-surface-variant group-hover:text-on-secondary-container">
              DEPLOY HULKBUSTER
            </span>
          </button>

          {/* Nanotech Shields */}
          <button
            onClick={handleDeflectors}
            className="group relative px-space-md py-space-sm rounded-lg bg-surface-container/80 hover:bg-primary-fixed-dim transition-all flex flex-col items-center justify-center gap-1 border border-primary-fixed/30 cursor-pointer"
          >
            <div className="flex items-center gap-1 text-primary-fixed group-hover:text-on-primary-fixed">
              <span className="material-symbols-outlined text-[18px]">security</span>
              <span className="font-label-code-xs text-label-code-xs uppercase font-bold tracking-wider">
                DEFLECTORS
              </span>
            </div>
            <span className="font-label-telemetry text-[11px] text-on-surface-variant group-hover:text-on-primary-fixed">
              CYCLE NANOMESH
            </span>
          </button>

          {/* Protocol Clean Slate Override */}
          <button
            onClick={() => {
              playAlertChime();
              setShowCleanSlateModal(true);
            }}
            className="group relative px-space-md py-space-sm rounded-lg bg-error-container/30 hover:bg-error-container transition-all flex flex-col items-center justify-center gap-1 border border-error/40 cursor-pointer"
          >
            <div className="flex items-center gap-1 text-error group-hover:text-on-error-container">
              <span className="material-symbols-outlined text-[18px]">crisis_alert</span>
              <span className="font-label-code-xs text-label-code-xs uppercase font-bold tracking-wider">
                CLEAN SLATE
              </span>
            </div>
            <span className="font-label-telemetry text-[11px] text-error/80 group-hover:text-on-error-container">
              ORDNANCE FLUSH
            </span>
          </button>
        </div>
      </div>

      {/* PROTOCOL CLEAN SLATE CONFIRMATION MODAL */}
      {showCleanSlateModal && (
        <div className="fixed inset-0 z-50 bg-black/80 backdrop-blur-md flex items-center justify-center p-4">
          <div className="bg-surface-container-lowest border border-error max-w-md w-full rounded-xl p-space-lg hud-glow-red flex flex-col gap-space-md">
            <div className="flex items-center gap-space-sm text-error">
              <span className="material-symbols-outlined text-[28px] animate-pulse">warning</span>
              <span className="font-headline-md text-headline-md tracking-wider">
                PROTOCOL CLEAN SLATE
              </span>
            </div>

            <p className="font-body-md text-on-surface text-[14px]">
              WARNING: Protocol Clean Slate will initiate full armor detonations across all active legionnaires. Authorize command?
            </p>

            <div className="bg-surface-container/70 p-space-sm rounded font-label-code-xs text-[11px] text-on-surface-variant border border-error/30">
              Awaiting Stark Biometric Retina Key: Anthony Edward Stark verified.
            </div>

            <div className="flex justify-end gap-space-sm pt-space-xs">
              <button
                onClick={() => setShowCleanSlateModal(false)}
                className="px-space-md py-space-xs rounded bg-surface-container-high hover:bg-surface-container-highest text-on-surface font-label-code-xs"
              >
                CANCEL
              </button>
              <button
                onClick={handleConfirmCleanSlate}
                className="px-space-md py-space-xs rounded bg-error text-on-error font-label-code-xs font-bold hover:bg-error/90 shadow-[0_0_15px_rgba(239,68,68,0.7)]"
              >
                AUTHORIZE DETONATION
              </button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
