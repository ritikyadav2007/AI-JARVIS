            <div className="flex items-center gap-1 text-primary group-hover:text-on-primary-container">
              <span className="material-symbols-outlined text-[18px]">adjust</span>
              <span className="font-label-code-xs text-label-code-xs uppercase font-bold tracking-wider">
                OVERDRIVE
              </span>
            </div>
            <span className="font-label-telemetry text-[11px] text-on-surface-variant group-hover:text-on-primary-container">
