                  className={`bg-surface-container/60 p-space-xs rounded flex items-center justify-between border-l-2 ${drone.border} hover:bg-surface-container-high/60 transition-all cursor-pointer ${
                    selectedDrone?.id === drone.id ? 'bg-surface-container-high ring-1 ring-primary-container/40' : ''
