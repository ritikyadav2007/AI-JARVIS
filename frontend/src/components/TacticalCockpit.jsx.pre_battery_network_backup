                  const fb = document.getElementById('recon-feed-fallback');
                  if (fb) fb.style.display = 'flex';
                }}
              />
              <div id="recon-feed-fallback" className="hidden absolute inset-0 bg-surface-container-lowest flex items-center justify-center text-primary-fixed-dim font-label-code-xs">
                [MALIBU AIRSPACE // SAT-RELAY 4 ONLINE]
              </div>
              <div className="absolute inset-0 bg-gradient-to-t from-surface-container-lowest via-transparent to-transparent pointer-events-none"></div>
              <div className="absolute bottom-2 left-2 flex items-center gap-1 font-label-code-xs text-label-code-xs text-primary">
                <span className="w-1.5 h-1.5 rounded-full bg-primary-container"></span>
                <span>SAT-RELAY // MALIBU AIRSPACE</span>
              </div>
            </div>
          </div>
        </div>
