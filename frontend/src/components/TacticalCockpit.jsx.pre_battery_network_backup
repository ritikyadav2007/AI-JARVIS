                src="https://lh3.googleusercontent.com/aida-public/AB6AXuCVDam-Zv0b6UL6g1rVgAHVcOzjQ_6cq0jROOyLXnku-9u7iDZARl0bOqFZit5UM_qWT1idffTqP8SHXDrwbcSbO50OuOzISNMIJk6-_owvahu6Wlh-D_Z_QUM1orlxG5gqqGGMqMEthTzB_zk36LiB0GSUbBcPsH5coS8T6YYOsHCiNJIXJElufTEMENEuaqxOFiavKb5MVvjt0cDfIafsEZ0kSSwxghF8IxKNl2U"
                alt="Sat-Relay Recon Malibu Airspace"
                onError={(e) => {
